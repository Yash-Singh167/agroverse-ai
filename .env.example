# AGROVERSE AI ENVIRONMENT CONFIGURATION

# Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database
# Use SQLite for zero-config local run, or Supabase PostgreSQL URI:
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./agroverse.db

# Supabase Auth & Storage (Optional if using local standalone auth mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Hardware Device Security
# The token the ESP8266 sends in Authorization: Bearer <token> or X-Device-Token header
AGRO_DEVICE_TOKEN=agro_esp8266_secure_key_2026
DEFAULT_DEVICE_ID=AGRO_001

# AI Conversational Assistant
AI_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-3-flash-preview

# Irrigation Safety Thresholds
DEFAULT_MOISTURE_THRESHOLD_LOW=30.0
DEFAULT_MOISTURE_THRESHOLD_HIGH=75.0
MAX_PUMP_CONTINUOUS_RUNTIME_SECONDS=600
DEVICE_OFFLINE_TIMEOUT_SECONDS=60
